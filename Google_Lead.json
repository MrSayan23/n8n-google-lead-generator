        "jsCode": "const html = $json.data || \"\";\n\nlet cleaned = html\n.replace(/<script[\\s\\S]*?<\\/script>/gi, '')\n.replace(/<style[\\s\\S]*?<\\/style>/gi, '')\n.replace(/<!--[\\s\\S]*?-->/g, '')\n.replace(/<[^>]+>/g, ' ')\n.replace(/https?:\\/\\/\\S+/g, '')\n.replace(/\\s+/g, ' ')\n.trim();\n\ncleaned = cleaned.slice(0, 3000);\n\n// NEW: Prevent the AI from crashing if the website is blank/dead\nif (!cleaned) {\n  cleaned = \"No text found on this website.\";\n}\n\nreturn {\n  json: {\n    clean_text: cleaned\n  }\n};"
